# Built by the notebook itself: §3 creates the SchNetPack database from the
# shipped xyz on first run, and watching that happen is the point.
data/*.db

# Checkpoints are large and mostly experimental. Ship exactly the ones the
# tutorial loads — adding another is one line here, deliberately.
checkpoints/*
# 20 MB, and what §7's USE_BIG_MODEL switches to for the research-scale
# comparison. Converted from the GPFF QM9 run by convert_gpff_seed999.py.
!checkpoints/gpff_big.pt
# The §6 model, so that cell loads instead of costing every reader ~12
# minutes; RETRAIN = True reproduces it. Carries its loss history, because
# §6 plots the curve either way. Built by make_checkpoint.py in the
# SchNetPack checkout's sandbox/gpff_notebook_loop/.
!checkpoints/gpff.pt

# Development scripts: they stay on disk, they do not go to students.
convert_gpff_seed999.py
gpff_qm9.py
sample_gpff_qm9.py
sample_direct_gpff_qm9.py


# Superseded copies kept for reference.
*.bak

__pycache__/
__marimo__/
*.pyc

# Instructor check for the section-8 tasks: runs the notebook's own runner
# cells against its folded reference solutions. Same rule: stays on disk.
check_solutions.py

# Locally executed copy with outputs baked in (~6 MB); notebook.ipynb stays
# the clean generated file.
notebook.executed.ipynb

# Jupyter scratch from opening the executed copy.
.ipynb_checkpoints/
